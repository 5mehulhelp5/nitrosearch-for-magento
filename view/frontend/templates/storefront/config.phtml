$config = $block->getConfigJson();
$loader = $block->getLoaderUrl();

// HALF-FORMED IS WORSE THAN ABSENT. No key, no host, no collection, no assets — no
// output at all. A connected-but-unverified store has no key yet, which is a normal
// state, and emitting a partial blob gives the loader something to fail on.
if ($config === '' || $loader === '') {
    return;
}
?>
<script type="application/json" id="nitrosearch-config"><?= /* @noEscape */ $config ?></script>
<script src="<?= $block->escapeUrl($loader) ?>" async defer></script>
