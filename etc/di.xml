<?xml version="1.0"?>
<!--
  One preference, deliberately.

  `NitroSearch\Settings` lives in lib/ and is framework-free: it takes a
  `SettingsStore` and knows nothing about Magento. This is the single line that
  tells Magento's object manager which implementation to hand it. Everything else
  in the module is constructor-injected concrete classes, which the compiler can
  resolve without help.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="NitroSearch\SettingsStore"
                type="NitroSearch\Search\Model\Settings\ConfigStore"/>

    <!--
      The full walk. `ResyncCheck` — vendored byte-identically from the shared core —
      depends on the PORT so its clock logic stays platform-free; this binds it to
      Magento's implementation, which enqueues the catalogue in one INSERT … SELECT
      rather than paging a cursor the way the other connectors must.
    -->
    <preference for="NitroSearch\Sync\FullWalk"
                type="NitroSearch\Search\Model\FullWalk"/>

    <!--
      Console commands are registered through the CommandList, not discovered.
      A command class that is not listed here simply does not exist as far as
      `bin/magento` is concerned — it fails as "command not found", which points
      at a typo rather than at a missing registration.
    -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="nitrosearch_status" xsi:type="object">NitroSearch\Search\Console\Command\Status</item>
                <item name="nitrosearch_subscribe" xsi:type="object">NitroSearch\Search\Console\Command\Subscribe</item>
                <item name="nitrosearch_unsubscribe" xsi:type="object">NitroSearch\Search\Console\Command\Unsubscribe</item>
                <item name="nitrosearch_serialize" xsi:type="object">NitroSearch\Search\Console\Command\Serialize</item>
                <item name="nitrosearch_drain" xsi:type="object">NitroSearch\Search\Console\Command\DrainCommand</item>
                <item name="nitrosearch_cache_invalidate" xsi:type="object">NitroSearch\Search\Console\Command\CacheInvalidate</item>
                <item name="nitrosearch_clocks" xsi:type="object">NitroSearch\Search\Console\Command\ClocksCommand</item>
            </argument>
        </arguments>
    </type>

    <!--
      The runtime CSP collector. Registered with a sortOrder above the static
      whitelist collector so this store's own engine host is added after the static
      hosts rather than instead of them.
    -->
    <type name="Magento\Csp\Model\Collector\CspWhitelistXmlCollector">
        <arguments>
            <argument name="sortOrder" xsi:type="number">10</argument>
        </arguments>
    </type>
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="nitrosearch_engine_host" xsi:type="object" sortOrder="50">NitroSearch\Search\Model\CspPolicy</item>
            </argument>
        </arguments>
    </type>
</config>
