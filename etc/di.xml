<?xml version="1.0"?>
<!--
  One preference, deliberately.

  `NitroSearch\Settings` lives in lib/ and is framework-free: it takes a
  `SettingsStore` and knows nothing about Magento. This is the single line that
  tells Magento's object manager which implementation to hand it. Everything else
  in the module is constructor-injected concrete classes, which the compiler can
  resolve without help.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="NitroSearch\SettingsStore"
                type="NitroSearch\Search\Model\Settings\ConfigStore"/>

    <!--
      Console commands are registered through the CommandList, not discovered.
      A command class that is not listed here simply does not exist as far as
      `bin/magento` is concerned — it fails as "command not found", which points
      at a typo rather than at a missing registration.
    -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="nitrosearch_status" xsi:type="object">NitroSearch\Search\Console\Command\Status</item>
                <item name="nitrosearch_subscribe" xsi:type="object">NitroSearch\Search\Console\Command\Subscribe</item>
                <item name="nitrosearch_unsubscribe" xsi:type="object">NitroSearch\Search\Console\Command\Unsubscribe</item>
                <item name="nitrosearch_serialize" xsi:type="object">NitroSearch\Search\Console\Command\Serialize</item>
                <item name="nitrosearch_drain" xsi:type="object">NitroSearch\Search\Console\Command\DrainCommand</item>
            </argument>
        </arguments>
    </type>
</config>
