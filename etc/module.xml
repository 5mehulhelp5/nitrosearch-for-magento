<?xml version="1.0"?>
<!--
  The <sequence> is not decoration. Magento loads modules in dependency order, and
  this module's mview view subscribes to tables owned by Magento_Catalog and reads
  scope from Magento_Store. Declaring the sequence is what guarantees those schemas
  exist before ours is processed.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="NitroSearch_Search">
        <sequence>
            <module name="Magento_Store"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Config"/>
            <module name="Magento_Backend"/>
            <module name="Magento_Indexer"/>
        </sequence>
    </module>
</config>
