<?xml version="1.0"?>
<!--
  The outbox: what has changed and not yet been sent.

  Same shape as the other three connectors' queue tables — object_type, object_id,
  op, a millisecond-epoch `version` used as a last-write-wins clock, and status —
  with one addition.

  `store_id` IS IN THE UNIQUE KEY FROM DAY ONE even though v1 indexes a single store
  view and nothing reads it yet ([D-055]). Magento has real scope, and adding a
  column to a unique key later means a migration on a table that by then holds live
  merchant state on every install. Carrying it now makes multi-store-view a backend
  change rather than a module rewrite, and costs one integer column today.

  `engine="innodb"` IS EXPLICIT. Declarative schema does not default it, and the
  ON DUPLICATE KEY upsert the mview action relies on needs the unique index that a
  MyISAM fallback would still give — but the transactional behaviour around the
  drain would be silently different.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="nitrosearch_outbox" resource="default" engine="innodb"
           comment="NitroSearch pending catalogue changes">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="object_type" length="32" nullable="false" default="product"/>
        <column xsi:type="int" name="object_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="op" length="16" nullable="false" default="upsert"/>
        <column xsi:type="bigint" name="version" unsigned="true" nullable="false" default="0"
                comment="ms epoch, last-write-wins clock"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="pending"/>
        <column xsi:type="int" name="store_id" unsigned="true" nullable="false" default="0"
                comment="reserved for multi-store-view; v1 always 0"/>
        <column xsi:type="int" name="attempts" unsigned="true" nullable="false" default="0"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="NITROSEARCH_OUTBOX_OBJECT">
            <column name="object_type"/>
            <column name="object_id"/>
            <column name="store_id"/>
        </constraint>
        <index referenceId="NITROSEARCH_OUTBOX_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <!--
      Attributed orders waiting to be reported.

      A TABLE, NOT A SESSION VALUE, AND THAT DISTINCTION IS THE WHOLE DESIGN. The
      cart-side marker lives in the shopper's session because losing one costs a
      single attribution nobody will notice. A report is different: it is written
      during checkout and sent minutes later, and losing it loses revenue data that
      cannot be reconstructed from anything else.

      REPORTING NEVER HAPPENS DURING CHECKOUT. The row is queued and the existing
      heartbeat sends it. A checkout must never be slowed, and must certainly never
      fail, because a search API was briefly unreachable — and an observer on order
      placement is exactly the wrong place to make an outbound HTTP request.
    -->
    <table name="nitrosearch_order_report" resource="default" engine="innodb"
           comment="NitroSearch attributed orders awaiting report">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false"/>
        <column xsi:type="bigint" name="value_cents" unsigned="true" nullable="false" default="0"
                comment="attributed slice only, integer minor units"/>
        <column xsi:type="varchar" name="currency" length="8" nullable="false"/>
        <column xsi:type="varchar" name="item_ids" length="512" nullable="false" default=""
                comment="comma-separated product ids that came from a search"/>
        <column xsi:type="varchar" name="q" length="128" nullable="false" default=""/>
        <column xsi:type="timestamp" name="occurred_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <!-- One report per order. An order placed twice by a retried request must not
             be counted twice, and the service's own dedupe on order_ref is a second
             line rather than the first. -->
        <constraint xsi:type="unique" referenceId="NITROSEARCH_ORDER_REPORT_ORDER">
            <column name="order_id"/>
        </constraint>
    </table>
</schema>
