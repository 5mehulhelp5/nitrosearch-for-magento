<?xml version="1.0"?>
<!--
  Stores → Configuration → Services → NitroSearch.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="nitrosearch" translate="label" type="text" sortOrder="400"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <label>NitroSearch</label>
            <tab>service</tab>
            <resource>NitroSearch_Search::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>Connection</label>

                <!--
                  THE BUTTONS ARE A FIELD WITH A frontend_model, which is the only way
                  to put an action into a config section. Magento's config form posts
                  the whole section; a button that merely submitted it could not
                  report what happened, so this renders its own control and posts to
                  the admin controller directly.
                -->
                <field id="status" translate="label" sortOrder="5" showInDefault="1">
                    <label>Status</label>
                    <frontend_model>NitroSearch\Search\Block\Adminhtml\System\Config\Connect</frontend_model>
                </field>

                <!--
                  REQUIRED, WITH NO SILENT DEFAULT ([D-055]). v1 indexes one store
                  view, and defaulting to admin scope (0) would index a scope with no
                  base URL and no currency — permalinks to nowhere and prices in
                  whatever the admin happens to carry. Making the merchant choose is
                  the honest version of a limitation we have.
                -->
                <field id="store_view_id" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" canRestore="0">
                    <label>Store view to index</label>
                    <source_model>Magento\Config\Model\Config\Source\Store</source_model>
                    <config_path>nitrosearch/credentials/store_view_id</config_path>
                    <comment><![CDATA[
                        <strong>NitroSearch v1 indexes one store view.</strong> Products, prices and
                        text from other store views are not indexed. If you run several websites on
                        separate domains you can connect each one as its own NitroSearch store;
                        several store views on one domain are not yet supported.
                    ]]></comment>
                </field>

                <field id="api_url" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1">
                    <label>API endpoint</label>
                    <config_path>nitrosearch/credentials/api_url</config_path>
                    <comment>Leave as the default unless NitroSearch support asks you to change it.</comment>
                </field>
            </group>

            <group id="storefront" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Storefront</label>

                <!--
                  SHIPS IN 1.0.0, NOT LATER. The widget opts out of analytics only on
                  an explicit `cfg.analytics === false`; an absent key is `undefined`,
                  which is not false. So without this toggle there is no layer at
                  which a merchant can decline — which is exactly the state the
                  OpenCart module shipped two releases in, and why a build guard now
                  exists for it. Defaults ON, so an existing store is never silently
                  switched off by an update.
                -->
                <field id="share_search_data" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1">
                    <label>Share anonymous search data</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>nitrosearch/credentials/share_search_data</config_path>
                    <comment>
                        Sends anonymous search terms and result counts so your dashboard can show
                        what shoppers look for. No personal data, no shopper identifiers. Turn this
                        off and the storefront widget stops reporting entirely.
                    </comment>
                </field>

                <!--
                  ═══ Appearance ═══
                  STORED AS PRESET NAMES, resolved to CSS custom-property values by
                  NitroSearch\Support\Design on the way out. The widget never learns a
                  preset name, so what "compact" means can improve in a later release
                  without any store's saved configuration having to change.

                  Every `<select>` below takes its options from Design::choices() via
                  one shared source model — the list is not written out again here.
                -->
                <field id="results_takeover" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1">
                    <label>Use NitroSearch for the search results page</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>nitrosearch/credentials/results_takeover</config_path>
                    <comment>
                        Yes replaces your theme's search results page with instant, filterable
                        results. No keeps your theme's page and uses NitroSearch only for the
                        drop-down while a shopper types.
                    </comment>
                </field>

                <field id="show_badge" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1">
                    <label>Show "Powered by NitroSearch"</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>nitrosearch/credentials/show_badge</config_path>
                    <comment>
                        Off by default — a credit on your storefront is your choice, not ours.
                    </comment>
                </field>

                <field id="design_look" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1">
                    <label>Result density</label>
                    <source_model>NitroSearch\Search\Model\Config\Source\Look</source_model>
                    <config_path>nitrosearch/credentials/design_look</config_path>
                    <comment>How much room each result takes in the drop-down.</comment>
                </field>

                <field id="design_scheme" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1">
                    <label>Colour scheme</label>
                    <source_model>NitroSearch\Search\Model\Config\Source\Scheme</source_model>
                    <config_path>nitrosearch/credentials/design_scheme</config_path>
                    <comment>
                        "Match the shopper's device" follows their own light or dark setting, decided
                        in the browser at the moment the panel is drawn.
                    </comment>
                </field>

                <field id="design_corners" translate="label" type="select" sortOrder="60"
                       showInDefault="1">
                    <label>Corners</label>
                    <source_model>NitroSearch\Search\Model\Config\Source\Corners</source_model>
                    <config_path>nitrosearch/credentials/design_corners</config_path>
                </field>

                <field id="design_accent" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1">
                    <label>Accent colour</label>
                    <backend_model>NitroSearch\Search\Model\Config\Backend\Accent</backend_model>
                    <config_path>nitrosearch/credentials/design_accent</config_path>
                    <comment><![CDATA[
                        A hex colour such as <code>#2563eb</code>, used for prices, the selected
                        result and the buttons inside the panel. Leave empty for the default.
                        Label text on the accent is chosen automatically for contrast, so a pale
                        accent gets dark text rather than an unreadable white. Anything that is not
                        a hex colour is ignored rather than stored.
                    ]]></comment>
                </field>

                <field id="design_width" translate="label" type="select" sortOrder="80"
                       showInDefault="1">
                    <label>Panel width</label>
                    <source_model>NitroSearch\Search\Model\Config\Source\Width</source_model>
                    <config_path>nitrosearch/credentials/design_width</config_path>
                </field>

                <field id="design_filters" translate="label" type="select" sortOrder="90"
                       showInDefault="1">
                    <label>Filters</label>
                    <source_model>NitroSearch\Search\Model\Config\Source\Filters</source_model>
                    <config_path>nitrosearch/credentials/design_filters</config_path>
                </field>
            </group>
        </section>
    </system>
</config>
