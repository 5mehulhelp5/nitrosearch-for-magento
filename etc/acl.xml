<?xml version="1.0"?>
<!--
  Without this resource the config section renders for nobody: Magento checks the
  `resource` named in system.xml against the admin role, and an unknown resource is
  denied rather than defaulted. Placed under stores_settings because that is where
  Stores → Configuration lives, so an admin role that already grants configuration
  access picks this up without a separate grant.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="NitroSearch_Search::config" title="NitroSearch" sortOrder="100"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
