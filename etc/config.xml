<?xml version="1.0"?>
<!--
  A <default> for EVERY field the module reads.

  A Magento config path with no default resolves to NULL, and the framework-free
  `Settings` layer above it would then see '' where it expected a value — which is
  indistinguishable from "the merchant cleared it". The defaults here mirror
  `NitroSearch\Settings::$defaults`; that class remains the authority for what a
  key MEANS, this file only guarantees the path resolves.

  EVERY PATH THE MODULE READS IS DECLARED HERE, INCLUDING THE CREDENTIALS, AND THE
  EARLIER REASONING FOR OMITTING THEM WAS WRONG.

  That reasoning was: "credentials are written by the connect flow and read back
  through the encrypted backend model; a default here would put an empty string
  through the decryptor". It does not survive contact. There is no encrypted backend
  model on these paths — none was ever declared — so there is no decryptor to feed.
  And an undeclared path is not merely undefaulted: `bin/magento config:show
  nitrosearch/credentials/sync_secret` answers **"path doesn't exist"** even with the
  row sitting in `core_config_data`.

  The consequence was a module that could not read credentials it had written
  itself: connect would store a sync secret, `Settings::isConnected()` would keep
  answering false, and the storefront would never emit a config blob. Found by
  seeding credentials and watching `nitrosearch:status` report "connected: no" while
  the rows were plainly in the table.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/config.xsd">
    <default>
        <nitrosearch>
            <credentials>
                <api_url>https://api.nitrosearch.io</api_url>
                <install_id/>
                <site_url/>
                <store_id/>
                <sync_key_id/>
                <sync_secret/>
                <scoped_search_key/>
                <engine_host/>
                <collection/>
                <search_public_id/>
                <widget_loader_url/>
                <widget_bundle_url/>
                <events_url/>
                <events_token/>
                <drain_token/>
                <connect_token/>
                <plan/>
                <last_sync/>
                <last_error/>
                <status_checked_at>0</status_checked_at>
                <config_refreshed_at>0</config_refreshed_at>
                <resync_token_done/>
                <fullsync_active>0</fullsync_active>
                <fullsync_cursor>0</fullsync_cursor>
                <fullsync_total>0</fullsync_total>
                <fullsync_started/>
                <fullsync_done/>
                <product_limit>0</product_limit>
                <product_count>0</product_count>
                <at_limit>0</at_limit>
                <claimed>0</claimed>
                <connected>0</connected>
                <verified>0</verified>
                <!--
                  Defaults TRUE, matching every other connector: an existing shop
                  must never be silently switched off by an update. The widget opts
                  out only on an explicit `cfg.analytics === false`, so this key
                  existing at all is what makes declining possible — the OpenCart
                  module shipped two releases without it and no layer let a
                  merchant decline.
                -->
                <share_search_data>1</share_search_data>
                <!-- Which store view is indexed. Empty means "not chosen yet", and
                     the admin screen requires a choice rather than defaulting to
                     the admin scope's 0. -->
                <store_view_id/>
            </credentials>
        </nitrosearch>
    </default>
</config>
